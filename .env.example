# Backend Settings
PROJECT_NAME="Egyptian ASR Dataset Builder"
# DATABASE_URL="sqlite:///./sql_app.db"
DATABASE_URL="mysql+pymysql://asr:change_me@mysql:3306/asr_dataset"

# MySQL container (must match DATABASE_URL)
MYSQL_DATABASE="asr_dataset"
MYSQL_USER="asr"
MYSQL_PASSWORD="change_me"
MYSQL_ROOT_PASSWORD="change_me_root"
REDIS_URL="redis://redis:6379/0"
DATA_PATH="./data"

# Audio Processing Settings
DEFAULT_SAMPLE_RATE=16000
DEFAULT_SILENCE_THRESH=-40
DEFAULT_MIN_SILENCE_LEN=700
DEFAULT_MIN_CHUNK_LEN=1000
DEFAULT_MAX_CHUNK_LEN=20000

# HuggingFace Settings
HF_TOKEN=""

# External ASR service
ASR_API_KEY=""
ASR_API_SECRET=""
ASR_ENDPOINT="http://<asr-server>:8768/v1/transcribe"
# Optional provenance metadata stored with every chunk
ASR_MODEL_NAME=""
ASR_MODEL_VERSION=""
ASR_LANGUAGE="ar-EG"
# ASR server limit (requests per minute)
ASR_RATE_LIMIT=30
# Trailing silence (ms) added before sending a chunk, so the ASR doesn't drop the last words
ASR_PAD_MS=500
# Re-check each chunk's last seconds and recover dropped final words (1 extra ASR request per chunk)
ASR_TAIL_CHECK=true
ASR_TAIL_MS=4000

# Automatic transcription: newly split videos are queued automatically.
# Toggle it at runtime in the Settings page. This interval controls the periodic
# safety-net sweep that retries missed/failed chunks (minutes, 0 = disable sweep).
AUTO_TRANSCRIBE_SWEEP_MINUTES=15
# Maximum number of videos queued per sweep (keeps the initial backlog from
# flooding the queue; the sweep will pick up the rest on its next run).
AUTO_TRANSCRIBE_BATCH_SIZE=20

# Automatic retry of failed/orphaned videos. Toggle it at runtime in Settings.
# The sweep queues at most AUTO_RETRY_BATCH_SIZE videos at a time, and each
# video gets at most AUTO_RETRY_MAX_ROUNDS automatic attempts (7-day window).
AUTO_RETRY_SWEEP_MINUTES=15
AUTO_RETRY_BATCH_SIZE=10
AUTO_RETRY_MAX_ROUNDS=5

# Failed transcription chunks are retried with exponential backoff, capped at
# this many minutes (default 6 hours) so a bad chunk can't hammer the ASR server.
AUTO_TRANSCRIBE_MAX_BACKOFF_MINUTES=360

# Delete activity log rows older than this many days (0 = keep forever).
# The retention sweep runs daily via Celery Beat.
ACTIVITY_LOG_RETENTION_DAYS=90

# Optional API protection. When API_KEY is set, every API request must send
# X-API-Key: <key> (the frontend reads VITE_API_KEY, which defaults to this).
API_KEY=""
# Comma-separated allowed browser origins. Use * only for trusted local setups.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Run `alembic upgrade head` before starting the app (enabled in Docker Compose).
RUN_MIGRATIONS=false

# YouTube Settings
YT_RETRY_COUNT=3

# Worker resources (lower these if the machine gets slow while downloading)
CELERY_CONCURRENCY=2
WORKER_MEM_LIMIT=5g
WORKER_CPUS=4
# Also download YouTube's Arabic captions (unused by the pipeline; adds YouTube requests)
DOWNLOAD_CAPTIONS=false

# Slack Notifications
SLACK_WEBHOOK_URL=""

# Frontend Settings
VITE_ALLOWED_HOSTS=""
# Must match API_KEY when API protection is enabled.
VITE_API_KEY=""
